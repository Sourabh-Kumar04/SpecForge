# ==============================================================================
# SpecForge Environment Configuration
# Track: Coding and Agentic Engineering (Nebius x NVIDIA Global AI Hackathon)
# ==============================================================================

# Nebius Token Factory / AI Cloud Configuration
# Endpoint for Nebius OpenAI-compatible API
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_API_KEY=your-nebius-api-key-here

# NVIDIA Open-Source Model IDs (Nemotron Family)
# Fast tier: used for targeted edits, quick validation, and file parsing
NEBIUS_MODEL_FAST=nvidia/nemotron-3-super-120b-a12b

# Reasoning tier: used for high-order architectural planning, deep fixer debugging
NEBIUS_MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b

# Tavily Search API (for real-time grounded documentation research)
# If omitted or empty, SpecForge uses high-fidelity grounded library fallbacks
TAVILY_API_KEY=your-tavily-api-key-here

# Offline / Evaluation Mode
# When true (or when NEBIUS_API_KEY is not set), SpecForge runs in mock LLM mode
# allowing 100% of unit/integration tests and local UI demos to run without credentials
MOCK_LLM=false

# Agent Pipeline Parameters
MAX_FIX_ITERATIONS=5
SANDBOX_TIMEOUT_SECONDS=35
DOCKER_SANDBOX_ENABLED=true

# Storage and Server Configuration
STORAGE_DIR=./data
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
